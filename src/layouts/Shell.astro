---
import '../styles/tokens.css';
import '../styles/app.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';

interface Props {
  title: string;
  kicker: string;
  lede?: string;
}
const { title, kicker, lede } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NYC Taxi × Weather</title>
    <meta name="description" content="Three years of debate compressed into one line: NYC yellow-taxi demand joined to hourly weather, 2025, queried live from MongoDB." />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f5f4" />
    <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-page={path}>
    <a class="skip" href="#content">Skip to content</a>
    <div class="app">
      <Sidebar path={path} />
      <div class="app__main">
        <Topbar />
        <main class="content" id="content">
          <header class="pagehead">
            <p class="fig-label">{kicker}</p>
            <h1 class="pagehead__h">{title}</h1>
            {lede && <p class="pagehead__lede">{lede}</p>}
          </header>
          <slot />
        </main>
      </div>
    </div>
    <slot name="scripts" />
  </body>
</html>
